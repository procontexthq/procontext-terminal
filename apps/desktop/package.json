{
  "name": "@terminal/desktop",
  "productName": "ProContext Terminal",
  "version": "0.1.0",
  "description": "ProContext Terminal desktop app.",
  "author": "ProContext",
  "private": true,
  "type": "module",
  "main": "./out/main/index.cjs",
  "scripts": {
    "predev": "pnpm electron:verify",
    "dev": "electron-vite dev",
    "predev:linux:headless": "pnpm electron:verify",
    "dev:linux:headless": "xvfb-run --auto-servernum --server-args=\"-screen 0 1280x960x24\" electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "pretest:e2e": "pnpm electron:verify",
    "test:e2e": "pnpm build && vitest run -c vitest.e2e.config.ts",
    "test:package": "pnpm package:current && vitest run -c vitest.package.config.ts && pnpm package:verify",
    "electron:install": "install-electron",
    "electron:verify": "node scripts/verify-electron-install.mjs",
    "package:clean": "node scripts/clean-package-output.mjs",
    "package:current": "pnpm package:clean && pnpm build && electron-builder --dir --publish never",
    "package:mac": "pnpm package:clean && pnpm build && electron-builder --mac dmg --publish never",
    "package:linux": "pnpm package:clean && pnpm build && electron-builder --linux AppImage deb --publish never",
    "package:win": "pnpm package:clean && pnpm build && electron-builder --win nsis --publish never",
    "package:verify": "node scripts/verify-packaged-app.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/orbitron": "^5.2.8",
    "@fontsource/share-tech-mono": "^5.2.7",
    "@terminal/agent-gateway": "workspace:*",
    "@terminal/config": "workspace:*",
    "@terminal/policy-engine": "workspace:*",
    "@terminal/protocol": "workspace:*",
    "@terminal/pty-host": "workspace:*",
    "@terminal/recorder": "workspace:*",
    "@terminal/session-core": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@types/node": "^24.13.1",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.0",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.59.1",
    "vite": "^7.3.3",
    "vitest": "^4.1.5",
    "ws": "^8.18.3"
  }
}
